{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm install && cd frontend && npm install",
    "dev": "node scripts/dev.mjs",
    "doctor": "node scripts/doctor.mjs",
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "bloggen": "cd backend && cargo run --bin bloggen --",
    "gen:types": "cross-env TS_RS_EXPORT_DIR=../frontend/src/types cargo test --manifest-path backend/Cargo.toml export_bindings",
    "blog:new": "node scripts/blog.mjs new",
    "blog:add-image": "node scripts/blog.mjs add-image",
    "blog:rm-image": "node scripts/blog.mjs rm-image",
    "blog:rm": "node scripts/blog.mjs rm",
    "blog:check": "node scripts/blog.mjs check",
    "check": "node scripts/validate-profile.mjs && node scripts/blog.mjs check",
    "lighthouse": "lhci autorun"
  },
  "devDependencies": {
    "@lhci/cli": "^0.14.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3"
  }
}
