# Copy this file to `.env` and fill in the values.
# `.env` is git-ignored and is loaded automatically by `npm run dev` and `npm start`.

# ---------------------------------------------------------------------------
# Hosting
# ---------------------------------------------------------------------------
# Public URL where the site is deployed (used for canonical/OG links & docs).
PUBLIC_SITE_URL=https://your-domain.com

# Port the backend listens on (default 8080).
PORT=8080

# ---------------------------------------------------------------------------
# Contact form email delivery
# ---------------------------------------------------------------------------
# Leave SMTP_URL empty to run the contact form in "mock" mode (logs only,
# frontend falls back to a mailto: link).
#
# Format: smtps://USERNAME:PASSWORD@smtp.host.com:465
#     or  smtp://USERNAME:PASSWORD@smtp.host.com:587?tls=required
SMTP_URL=

# Where contact-form submissions are delivered.
CONTACT_TO=you@example.com

# From address on the delivered mail (defaults to CONTACT_TO if unset).
CONTACT_FROM=portfolio@your-domain.com
